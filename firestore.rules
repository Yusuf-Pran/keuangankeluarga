rules_version = '2';

// Aturan keamanan Firestore untuk SakuGenius (login akun + persetujuan admin).
// Pasang lewat Firebase Console > Firestore Database > Rules, lalu klik Publish.
//
// Koleksi:
// - members/{uid}       : profil akun + status (pending / approved / rejected).
//                         Hanya ditulis oleh Google Apps Script (admin), bukan aplikasi.
// - phoneIndex/{nohp}   : no. HP (format 628xx) -> email, untuk login pakai no. HP.
//                         Hanya ditulis oleh Google Apps Script.
// - userData/{uid}      : data keuangan milik akun itu sendiri.
// - sakugenius_sync/... : data lama (versi kode lisensi), hanya bisa dibaca
//                         pemiliknya untuk dipindahkan, tidak bisa ditulis lagi.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved';
    }

    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /phoneIndex/{phone} {
      allow get: if true;
      allow list, write: if false;
    }

    match /userData/{uid} {
      allow read: if signedIn() && request.auth.uid == uid && isApproved();

      allow create, update: if signedIn() && request.auth.uid == uid && isApproved()
                            && request.resource.data.keys().hasOnly(['transactions', 'categories'])
                            && request.resource.data.transactions is list
                            && request.resource.data.categories is list
                            && request.resource.data.categories.size() <= 200;

      allow delete: if false;
    }

    // Data lama: hanya pemilik email yang sudah disetujui yang bisa membacanya.
    match /sakugenius_sync/{emailId} {
      allow read: if isApproved()
                  && request.auth.token.email != null
                  && emailId.lower() == request.auth.token.email.lower().replace('[^a-z0-9]', '_');
      allow write: if false;
    }

    // Tolak semua akses lain.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
